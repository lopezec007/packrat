# Packrat service configuration.
#
# Copy to /etc/packrat/packrat.env (deploy/install.sh does this on first
# install and never overwrites it afterwards). Lines are KEY=VALUE, read by
# systemd's EnvironmentFile=; after editing run: systemctl restart packrat
#
# Everything is commented out below, i.e. the defaults from packrat.service
# apply.

# Address to listen on. 0.0.0.0 makes the app reachable from the whole LAN /
# VPN; use 127.0.0.1:8082 to restrict it to this machine (e.g. behind a
# reverse proxy). Ports below 1024 need the capability change noted in
# packrat.service.
#PACKRAT_ADDR=0.0.0.0:8082

# PostgreSQL connection. The default connects over the local socket as the
# database role "packrat" (peer authentication, no password), which
# deploy/install.sh sets up. For a database elsewhere use e.g.
#   postgres://packrat:password@db.example.lan:5432/packrat
#PACKRAT_DATABASE_URL=postgres:///packrat?host=/var/run/postgresql

# Where the database is dumped (pg_dump, custom format) just before an
# upgrade changes its schema. If the dump cannot be made the schema is left
# alone and the service does not start. Dumps are not removed: clear out old
# ones yourself.
#PACKRAT_BACKUP_DIR=/var/lib/packrat/backups

# Set to 1 to upgrade the schema without that dump: only when the database
# has been backed up some other way (say, when it is on another host and
# this machine has no pg_dump, or an older one than the server).
#PACKRAT_NO_BACKUP=
