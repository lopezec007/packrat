# systemd unit for Packrat (packing lists).
# Installed by deploy/install.sh to /etc/systemd/system/packrat.service.
#
# Configuration lives in /etc/packrat/packrat.env (see packrat.env.example);
# the Environment= lines below are the defaults when that file is absent or
# does not set a variable.

[Unit]
Description=Packrat packing lists
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=packrat
Group=packrat

# Defaults; values in the EnvironmentFile override these. The database URL
# connects over PostgreSQL's local socket as the role named like the service
# user (peer authentication: no password anywhere).
Environment=PACKRAT_ADDR=0.0.0.0:8082
Environment=PACKRAT_DATABASE_URL=postgres:///packrat?host=/var/run/postgresql
EnvironmentFile=-/etc/packrat/packrat.env

ExecStart=/usr/local/bin/packrat

# All data lives in PostgreSQL; the service itself writes nothing.
WorkingDirectory=/
UMask=0077

Restart=on-failure
RestartSec=2s

# Hardening. The service needs nothing beyond: listen on a TCP port, talk to
# PostgreSQL over its Unix socket (or TCP, for a database elsewhere) and read
# its own binary.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
# To listen on a privileged port (e.g. PACKRAT_ADDR=0.0.0.0:80) replace the
# line above with:
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
